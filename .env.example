# Setup:
#   cp .env.example .env
#   chmod 600 .env          # keeps the keys readable only by you
#   $EDITOR .env            # fill in the values below
#   open a new terminal     # ~/.bashrc auto-loads .env for /workspaces/bluesky
#                           # if a key is still unset afterwards, your container
#                           # predates the auto-load — rebuild it once
#
# To load it by hand in an existing shell:
#   set -a && source .env && set +a
# The `set -a` matters: a plain `source .env` sets shell variables without
# exporting them, so child processes (Claude Code's ${HBIX_API_KEY} expansion
# in .mcp.json, opencode's {env:HBIX_API_KEY}) would not see the key.

# hbix API key, used by all six MCP servers in .mcp.json and opencode.json.
# Required. Obtained by register -> admin approval -> mint; see
# .github/copilot-instructions.md. Verify with: opencode mcp list
HBIX_API_KEY=your_key

# OpenWebUI / Ollama LLM server key (opencode.json substitutes
# {env:OPENWEBUI_API_KEY}). Required to use opencode as configured: the
# resolved default model is openwebui/north-mini, so without this key opencode
# fails on its first request. Only skippable if you always select a model from
# another provider — vllm/* needs no key, anthropic/* needs the one below.
# Check the resolved default with: opencode debug config
OPENWEBUI_API_KEY=your_other_key

# Anthropic API key for opencode's anthropic/* models
# (opencode.json substitutes {env:ANTHROPIC_API_KEY}). Optional — leave unset
# if you use the openwebui/* or vllm/* models instead. Note that anthropic
# models are listed by `opencode models` whether or not this is set; without
# it they fail at request time.
ANTHROPIC_API_KEY=
