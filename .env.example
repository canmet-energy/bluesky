# HBIX API credentials
# Copy to .env and replace with your own key, then load it with:
#   set -a && source .env && set +a
# The `set -a` matters: a plain `source .env` sets shell variables without
# exporting them, so child processes (Claude Code's ${HBIX_API_KEY} expansion
# in .mcp.json, opencode's {env:HBIX_API_KEY}) would not see the key.
# The devcontainer's ~/.bashrc already does this for /workspaces/bluesky/.env.
HBIX_API_KEY=your_key
# OpenWebUI / Ollama LLM server key for report executive summaries
# (opencode.json substitutes {env:OPENWEBUI_API_KEY}). Optional — only needed for
# the LLM summary feature.
OPENWEBUI_API_KEY=your_other_key
